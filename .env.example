# Absolute path to the official MME_Benchmark_release_version directory.
MME_ROOT=/absolute/path/to/MME_Benchmark_release_version

# Optional local checkout of AnchorPrune. Leave empty if unavailable.
ANCHORPRUNE_PATH=

# Optional installation controls
# INSTALL_FLASH_ATTN=auto  # auto | 0 (skip)
# FLASH_ATTN_MAX_JOBS=4

# Optional: path to the official MME calculation.py scorer (if separately downloaded).
# MME_EVAL_TOOL=/path/to/eval_tool/calculation.py

# H3-only experiment data (required for --profile h3)
POPE_ROOT=/absolute/path/to/POPE/images
POPE_FILE=/absolute/path/to/pope_test.jsonl
